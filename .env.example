# Sumber konten (WordPress REST API). Ganti ke cms.domain-anda.com saat produksi.
WP_API_URL=https://wordpress.org/news/wp-json/wp/v2

# URL publik situs ini. Dipakai untuk canonical, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=https://contoh-anda.vercel.app

# Rahasia webhook revalidasi. Isi bebas, samakan dengan yang dipasang di WordPress
# sebagai NEXTJS_REVALIDATE_SECRET.
REVALIDATE_SECRET=ganti-dengan-string-acak-panjang

# Rahasia tautan pratinjau draft. Samakan dengan NEXTJS_PREVIEW_SECRET di WordPress.
# Tanpa ini, /api/draft menolak seluruh permintaan.
WP_PREVIEW_SECRET=ganti-dengan-string-acak-lain

# Kredensial baca-draft: Application Password milik satu akun editor
# (WordPress → Users → Profile → Application Passwords).
# Kosongkan kalau tidak memakai pratinjau draft — situs tetap berjalan normal.
WP_USER=
WP_APP_PASSWORD=
