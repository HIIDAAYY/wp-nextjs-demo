# Sumber konten (WordPress REST API). Ganti ke cms.domain-anda.com saat produksi.
WP_API_URL=https://wordpress.org/news/wp-json/wp/v2

# URL publik situs ini. Dipakai untuk canonical, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=https://contoh-anda.vercel.app

# Rahasia webhook revalidasi. Isi bebas, samakan dengan yang dipasang di WordPress.
REVALIDATE_SECRET=ganti-dengan-string-acak-panjang
